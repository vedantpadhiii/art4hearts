{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "art4hearts-chat",
  "main": "index.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "A4H_MODEL": "claude-sonnet-5",
    "A4H_ORIGINS": "https://art4heartsinternational.org,https://www.art4heartsinternational.org,https://art4hearts-7t3r.onrender.com,http://localhost:8787,http://127.0.0.1:8787"
  },
  "ratelimits": [
    { "name": "CHAT_PER_IP", "namespace_id": "41881001", "simple": { "limit": 5, "period": 60 } },
    { "name": "CHAT_TOTAL", "namespace_id": "41881002", "simple": { "limit": 20, "period": 60 } }
  ],
  "build": { "command": "node build-preview.mjs" },
  "observability": { "enabled": false }
}
