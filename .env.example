# Server-only credentials. Never use REACT_APP_ for the API key.
ANTHROPIC_API_KEY=
A4H_MODEL=claude-sonnet-5
A4H_ORIGINS=https://art4heartsinternational.org,https://www.art4heartsinternational.org,http://localhost:3000,http://127.0.0.1:3000
PORT=8000
# Enable only behind the trusted hosting proxy; leave disabled for direct access.
A4H_TRUST_PROXY=0
# Optional protected names separated by |. Keep this server-only.
A4H_BLOCKED_NAMES=
